{
  "extends": "../common/tsconfig/strict.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "customConditions": ["development"],
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "generated/**/*.ts",
    "seeds/**/*.ts",
    "seed.ts",
    "prisma.config.ts",
    "vitest.config.mts"
  ],
  "exclude": ["node_modules", "dist"]
}
