NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Local, non-secret connection. Put real credentials in an ignored .env file.
DATABASE_URL=postgresql://ecommerce@localhost:5432/ecommerce
# Storefront origin used for CORS and for links in emails.
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
TRUST_PROXY=false
# Optional. Leave all three empty to disable Razorpay and offer Cash on Delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
